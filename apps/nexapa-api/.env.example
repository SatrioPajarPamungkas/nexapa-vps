APP_NAME="Nexapa API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.nexapa.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nexapa.me
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nexapa API Configuration
NEXAPA_ALLOW_GUEST_API=false
NEXAPA_WORKER_TOKEN=
NEXAPA_MAX_DOWNLOAD_URLS=50
NEXAPA_MAX_PROFILE_RESULT_SELECTION=500
NEXAPA_WORKER_HEARTBEAT_TIMEOUT=120
NEXAPA_ALLOWED_STORAGE_DISKS=local,public
NEXAPA_ALLOWED_STORAGE_PATH_PREFIXES=media,thumbnails,downloads
FRONTEND_URL=https://app.nexapa.app
SANCTUM_STATEFUL_DOMAINS=app.nexapa.me

# TikTok OAuth Configuration
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.nexapa.me/api/v1/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.nexapa.me/api/v1/auth/google/callback

# Nexapa CRM read-only directory (server-side only)
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_ROLE_KEY=
CRM_SUPABASE_TIMEOUT=10
CRM_SUPABASE_CACHE_TTL=45
