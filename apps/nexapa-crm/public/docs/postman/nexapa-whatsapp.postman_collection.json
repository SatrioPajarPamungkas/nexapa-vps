    {
      "name": "06 - Webhook",
      "item": [
        {
          "name": "Webhook Verification",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/whatsapp/webhook?hub.mode=subscribe&hub.verify_token={{verify_token}}&hub.challenge=123456789",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{verify_token}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "123456789"
                }
              ]
            },
            "description": "Simulasi challenge verification Meta."
          },
          "response": []
        },
        {
          "name": "Webhook Event Sample",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/whatsapp/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ]
            },
            "description": "Contoh inbound webhook. Production Meta POST memakai X-Hub-Signature-256.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WABA_ID\",\n      \"changes\": [\n        {\n          \"field\": \"messages\",\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"15550000000\",\n              \"phone_number_id\": \"PHONE_NUMBER_ID\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Postman Test\"\n                },\n                \"wa_id\": \"{{phone_number}}\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"{{phone_number}}\",\n                \"id\": \"wamid.POSTMAN_TEST\",\n                \"timestamp\": \"1755300000\",\n                \"text\": {\n                  \"body\": \"Test inbound webhook from Postman\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
            }
          },
          "response": []
        }
      ]
    },
