              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"{{waba_id}}\",\n      \"changes\": [\n        {\n          \"field\": \"messages\",\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"15550000000\",\n              \"phone_number_id\": \"{{phone_number_id}}\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Postman User\"\n                },\n                \"wa_id\": \"{{phone_number}}\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"{{phone_number}}\",\n                \"id\": \"wamid.TEXT_SAMPLE\",\n                \"timestamp\": \"1755300000\",\n                \"type\": \"text\",\n                \"text\": {\n                  \"body\": \"Hello Nexapa\"\n                }\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
            }
          },
          "response": []
        },
