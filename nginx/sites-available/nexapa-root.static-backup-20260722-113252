server {
    listen 80;
    listen [::]:80;

    server_name nexapa.me;

    return 301 https://nexapa.me$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name nexapa.me;

    root /var/www/nexapa-site;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/app.nexapa.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.nexapa.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Main routes
    location = / {
        try_files /index.html =404;
    }

    location = /privacy {
        try_files /privacy.html =404;
    }

    location = /privacy/ {
        try_files /privacy.html =404;
    }

    location = /terms {
        try_files /terms.html =404;
    }

    location = /terms/ {
        try_files /terms.html =404;
    }

    location = /contact {
        try_files /contact.html =404;
    }

    location = /contact/ {
        try_files /contact.html =404;
    }

    # Static assets with caching
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Deny access to hidden files except .well-known
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~ /\.well-known {
        allow all;
    }

    # Default 404 for unknown routes
    location / {
        return 404;
    }
}
