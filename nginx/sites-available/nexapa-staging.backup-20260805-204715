server {
    listen 80;
    listen [::]:80;

    server_name new.nexapa.app;

    root /var/www/nexapa-staging;
    index index.html;

    charset utf-8;

    # Jangan masukkan staging ke Google.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
